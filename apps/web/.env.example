# apps/web 전용 — Vite는 VITE_ 접두사가 붙은 변수만 클라이언트에 노출한다.
# .env로 복사해서 쓴다.

# Anchor.toml은 localnet·devnet 모두 같은 program id를 쓰므로 클러스터 전환은
# 이 RPC URL 하나만 바꾸면 된다 (packages/schema/idl/movie_escrow.json의
# "address" 필드가 program id를 이미 담고 있음).
VITE_SOLANA_RPC_URL=http://127.0.0.1:8899

# explorer 링크 생성용. localnet이면 커스텀 RPC로, devnet이면 ?cluster=devnet으로 연결된다.
VITE_SOLANA_CLUSTER=localnet

# B/D가 init_escrow로 만든 데모 영화의 movieId. 비우면 mocks/demo.ts와 같은
# 값("indie-2026-001")을 기본으로 쓴다 — 실제 온체인 에스크로 시드와 다르면
# deposit이 "Account does not exist"로 실패한다.
VITE_MOVIE_ID=indie-2026-001
