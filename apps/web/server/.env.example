# apps/web/server 전용. .env로 복사해서 쓴다.

# STAGE 0 계약서 추출 (Gemini)
GEMINI_API_KEY=

# STAGE 6 대시보드 KOBIS 대조 패널
KOBIS_API_KEY=

# ── 정산 배치 프록시 (agent-proxy.js) ──────────────────────────────────
# 배포된 Agent(Cloud Run, IAM 인증 필요)를 대신 호출할 때만 채운다.
# 로컬 개발 중엔 둘 다 비워두면 인증 없이 로컬 agent(4030)로 그대로 넘어간다.
# docs/ponyo_work/GCP_DEPLOYMENT_GUIDE.md §7 참고.

# Cloud Run Agent URL. 비우면 http://localhost:4030 사용.
AGENT_BASE_URL=

# roles/run.invoker만 가진 서비스 계정 키 경로 (.secrets/ 아래, 절대 커밋 금지)
WEB_PROXY_KEY_PATH=
