# apps/web/server 전용. .env로 복사해서 쓴다.

# STAGE 0 계약서 추출 (Gemini)
GEMINI_API_KEY=

# STAGE 6 대시보드 KOBIS 대조 패널
KOBIS_API_KEY=

# ── 정산 배치 프록시 (agent-proxy.js) ──────────────────────────────────
# 배포된 Agent(Cloud Run, IAM 인증 필요)를 대신 호출할 때 위 두 값을 채운다.
# 로컬 개발 중엔 비워두면 인증 없이 로컬 agent(4030)로 그대로 넘어간다.
# docs/ponyo_work/GCP_DEPLOYMENT_GUIDE.md §7 참고.

# Cloud Run Agent URL. 비우면 http://localhost:4030 사용.
AGENT_BASE_URL=

# Cloud Run Agent를 호출할 때 true. 배포 환경에서는 연결된 런타임 서비스 계정
# (chaincrew-web)의 ADC를 자동 사용하므로 JSON 키 파일이 필요 없다.
AGENT_USE_IAM_AUTH=false

# 로컬에서 원격 Agent를 시험할 때만 선택적으로 사용하는 키 경로.
# 운영 Cloud Run에서는 비워두며, 생성·커밋·프론트 노출하지 않는다.
WEB_PROXY_KEY_PATH=
