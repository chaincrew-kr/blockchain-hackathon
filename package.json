{
  "name": "blockchain-hackathon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Solana x402 agent payments monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@chaincrew/api",
    "start": "npm run start --workspace=@chaincrew/api",
    "client": "npm run start --workspace=@chaincrew/agent",
    "inspect:402": "npm run inspect:402 --workspace=@chaincrew/agent",
    "wallet:create": "npm run wallet:create --workspace=@chaincrew/agent",
    "wallet:address": "npm run wallet:address --workspace=@chaincrew/agent",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint --config config/eslint.config.js apps packages",
    "format": "prettier --write \"apps/**/*.{ts,tsx,js,json,md}\" \"packages/**/*.{ts,tsx,js,json,md}\" \"config/**/*.{js,json}\" \"docs/**/*.md\" \"infra/**/*.{yml,yaml}\" \"*.{json,md}\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,js,json,md}\" \"packages/**/*.{ts,tsx,js,json,md}\" \"config/**/*.{js,json}\" \"docs/**/*.md\" \"infra/**/*.{yml,yaml}\" \"*.{json,md}\"",
    "check": "npm run lint && npm run typecheck && npm test && npm run format:check",
    "docker:up": "docker compose --env-file .env -f infra/compose.yaml up --build",
    "docker:down": "docker compose --env-file .env -f infra/compose.yaml down"
  },
  "engines": {
    "node": ">=22.10.0",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
