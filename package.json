{
  "name": "blockchain-hackathon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI 영화 정산 에이전트 — Solana 에스크로 + 위험조정검증 (PLAN-INDIE-003)",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=@chaincrew/web",
    "dev:agent": "npm run dev --workspace=@chaincrew/agent",
    "wallet:create": "npm run wallet:create --workspace=@chaincrew/wallet-tools --",
    "wallet:address": "npm run wallet:address --workspace=@chaincrew/wallet-tools --",
    "devnet:build-init": "npm run build-init --workspace=@chaincrew/devnet-seed --",
    "devnet:sign-submit": "npm run sign-submit --workspace=@chaincrew/devnet-seed --",
    "devnet:fund": "npm run fund --workspace=@chaincrew/devnet-seed --",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint --config config/eslint.config.js apps packages tools",
    "format": "prettier --write \"apps/**/*.{ts,tsx,js,json,md}\" \"packages/**/*.{ts,tsx,js,json,md}\" \"tools/**/*.{ts,tsx,js,json,md}\" \"config/**/*.{js,json}\" \"docs/**/*.md\" \"*.{json,md}\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,js,json,md}\" \"packages/**/*.{ts,tsx,js,json,md}\" \"tools/**/*.{ts,tsx,js,json,md}\" \"config/**/*.{js,json}\" \"docs/**/*.md\" \"*.{json,md}\"",
    "check": "npm run lint && npm run typecheck && npm test && npm run format:check"
  },
  "engines": {
    "node": ">=22.10.0",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "@coral-xyz/anchor": "^0.32.1",
    "@eslint/js": "^10.0.1",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.98.4",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
