# ── 공통 ──────────────────────────────────────────────────────────────
# 개발은 localnet, Devnet 이전은 8/1 이후 (실행계획서 §4)
SOLANA_RPC_URL=http://127.0.0.1:8899

# STAGE 0 계약 추출 · STAGE 4 판정 근거 생성 (A·D)
GEMINI_API_KEY=

# STAGE 6 대시보드 KOBIS 대조 패널 (A)
KOBIS_API_KEY=

# ── apps/agent — 정산 에이전트 서버 ───────────────────────────────────
AGENT_PORT=4030

# 체인 연결 — 아래 셋이 모두 채워져야 실제 온체인 호출을 시도한다.
# 하나라도 비면 스텁으로 동작하고 tx 서명이 STUB_ 로 시작한다(가짜).
# 현재 상태는 GET /health 의 "chain" 필드로 확인할 수 있다.
#
# SOLANA_PROGRAM_ID  B·C가 배포한 movie_escrow 프로그램 ID (Anchor.toml 참고)
# AGENT_KEYPAIR_PATH MovieEscrow.authority로 서명할 Solana CLI JSON 키파일 경로.
#                    키 내용을 환경변수에 넣지 말고 경로만 지정할 것.
#                    Cloud Run에서는 Secret Manager 마운트 경로를 넘긴다.
SOLANA_PROGRAM_ID=
AGENT_KEYPAIR_PATH=.secrets/agent-devnet.json

# ── tools/wallet — Devnet 지갑 도구 ───────────────────────────────────
# Solana CLI JSON 키파일 (숫자 배열). 개인키를 여기 직접 쓰지 말 것.
SVM_KEYPAIR_PATH=.secrets/buyer-devnet.json

# ── legacy/x402-* (Phase 2에서만 사용) ────────────────────────────────
# FACILITATOR_URL=https://x402.org/facilitator
# X402_NETWORK=solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1
