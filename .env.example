# Resource server
PORT=4021
FACILITATOR_URL=https://x402.org/facilitator
X402_NETWORK=solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1
PAYMENT_PRICE=$0.001

# Public Solana address that receives payment. Never put a private key here.
SVM_ADDRESS=replace_with_your_solana_devnet_address

# Buyer/client settings
RESOURCE_SERVER_URL=http://localhost:4021
# Solana CLI JSON keypair (numeric array). Required only for `npm run client`.
SVM_KEYPAIR_PATH=.secrets/buyer-devnet.json
# Optional alternative: a base58-encoded keypair string.
# SVM_PRIVATE_KEY=
